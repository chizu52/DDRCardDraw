{
  // Scoped tsconfig for the Workers backend (Durable Objects deployed via
  // wrangler). Split out from the root tsconfig.json on purpose: this code
  // runs in the Workers runtime, not a browser, so it needs Cloudflare's
  // runtime globals (DurableObjectState, the `cloudflare:workers` module
  // that partyserver's Server class imports, etc.) instead of DOM lib --
  // mixing the two in one TS program causes conflicting global
  // declarations (`fetch`, `Response`, `WebSocket`, `crypto`, ...).
  //
  // worker-configuration.d.ts (repo root) is regenerated by `wrangler
  // types` from wrangler.jsonc and is fully self-contained -- it already
  // bundles the complete Workers runtime type surface, not just this
  // project's Env interface, so nothing from @cloudflare/workers-types
  // needs to be added separately here (that would risk duplicate/
  // conflicting declarations of the same globals).
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["esnext"]
  },
  // NOT "**/*" -- src/party/ also holds the browser-side WebSocket client
  // (client.tsx, diagnostics-dialog.tsx, heartbeat-worker.ts) that needs DOM
  // lib, not Workers globals. Only the actual backend entry points are
  // listed explicitly; their own imports (root-reducer, store, migrations,
  // ./types, ./database.types) pull in transitively and type-check fine
  // here since they're plain data/state logic with no DOM dependency.
  "include": [
    "server.ts",
    "capture-bridge-server.ts",
    "env.d.ts",
    "../../worker-configuration.d.ts"
  ],
  "exclude": []
}
